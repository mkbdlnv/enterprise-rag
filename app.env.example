# Without a key the service answers extractively (quotes the best source sentences).
LLM_API_KEY=
# Any OpenAI-compatible endpoint, up to /v1 (Gemini by default).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# One model or a comma-separated fallback chain, best first.
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_CORPUS=data/corpus
